# Public project information (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY — never prefix with NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
# Free router initially; replace with a specifically tested free model later.
OPENROUTER_TEXT_MODEL=openrouter/free
ALLOW_PAID_TEXT=false
AI_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=200
# Optional paid image provider. Disabled until a model and cost are selected.
ENABLE_IMAGE_GENERATION=false
OPENROUTER_IMAGE_MODEL=

# Server-only key from https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Gemini takes priority for text when configured. Keep this key server-side.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
